    "@hookform/resolvers": "7.0.3",
    "@next/third-parties": "16.4.5",
    "@paralleldrive/cuid2": "3.3.0",
    "@react-email/render": "2.2.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-safe-action": "8.7.3",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "nodemailer": "10.3.1",
    "nuqs": "2.10.2",
    "postgres": "4.1.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
